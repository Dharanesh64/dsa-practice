#include <bits/stdc++.h>
using namespace std;

struct TreeNode {
    int val;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x) {
        val = x;
        left = right = NULL;
    }
};

// Build tree from level order
TreeNode* buildTree(vector<int>& arr) {
    if (arr.size() == 0 || arr[0] == -1001) return NULL;

    TreeNode* root = new TreeNode(arr[0]);
    queue<TreeNode*> q;
    q.push(root);

    int i = 1;
    while (!q.empty() && i < arr.size()) {
        TreeNode* curr = q.front(); q.pop();

        if (arr[i] != -1001) {
            curr->left = new TreeNode(arr[i]);
            q.push(curr->left);
        }
        i++;

        if (i < arr.size() && arr[i] != -1001) {
            curr->right = new TreeNode(arr[i]);
            q.push(curr->right);
        }
        i++;
    }

    return root;
}

// DFS + prefix sum
int dfs(TreeNode* node, long currSum, int target, unordered_map<long,int>& mp) {
    if (!node) return 0;

    currSum += node->val;

    int count = 0;

    if (mp.count(currSum - target)) {
        count += mp[currSum - target];
    }

    mp[currSum]++;

    count += dfs(node->left, currSum, target, mp);
    count += dfs(node->right, currSum, target, mp);

    mp[currSum]--; // backtrack

    return count;
}

int pathSum(TreeNode* root, int target) {
    unordered_map<long,int> mp;
    mp[0] = 1; // important

    return dfs(root, 0, target, mp);
}

int main() {
    string line;
    getline(cin, line);

    if (line.empty()) {
        cout << "No valid path found";
        return 0;
    }

    stringstream ss(line);
    vector<int> arr;
    int x;

    while (ss >> x) arr.push_back(x);

    int target;
    cin >> target;

    TreeNode* root = buildTree(arr);

    int ans = pathSum(root, target);

    if (ans == 0)
        cout << "No valid path found";
    else
        cout << "Number of valid paths: " << ans;
}
